# Etap 3 - przykladowa konfiguracja do pracy lokalnej z `docker compose up -d`.
# Skopiuj do .env (gitignore) albo wyeksportuj recznie przed `uvicorn api.main:app`.
# Klucz ponizej to publiczny, znany klucz deweloperski Azurite - nie jest sekretem.

DATABASE_URL=postgresql://underwriter:underwriter@localhost:5432/underwriter
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
KONTENER_BLOB=wnioski

# atrapa (domyslnie, zero kosztow) albo gemini albo azure
MODEL_AGENTA=atrapa
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING=low

CORS_ORIGINS=http://localhost:3000

# Etap 5 - Azure OpenAI (gpt-5-mini) + Document Intelligence (OCR).
# Uwierzytelnienie wylacznie Entra ID (disableLocalAuth=true na obu zasobach) -
# lokalnie `az login` (Azure CLI musi byc w PATH procesu uruchamiajacego Pythona),
# w Etapie 6 Managed Identity bez zmiany kodu. Zadnych kluczy API w tym pliku.
AZURE_OPENAI_ENDPOINT=https://uw-demo-aoai-xx1.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_REASONING=low
AZURE_DOCINT_ENDPOINT=https://uw-demo-docint-xx1.cognitiveservices.azure.com/

# Etap 10 - modul szkodowy (RAG po OWU). Bez tych zmiennych API uzywa lokalnego BM25
# (WYSZUKIWARKA=lokalna, zero sieci). Azure AI Search: auth RBAC (az login lokalnie,
# Managed Identity w Azure) - zadnych kluczy Search w tym pliku.
# WYSZUKIWARKA=azure
# AZURE_SEARCH_ENDPOINT=https://uw-demo-search-xx1.search.windows.net
# AZURE_SEARCH_INDEX=owu-mienie-v1
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_SEARCH_SEMANTIC=0

# Etap 12 - RAG po OWU przez Qdrant (trzecia wyszukiwarka obok Azure AI Search i BM25
# lokalnego). Wektor gesty nadal liczy Azure OpenAI (AZURE_OPENAI_ENDPOINT powyzej jest
# wymagany), wiec zadnych kluczy Qdrant tutaj. Bez QDRANT_URL/QDRANT_PATH: tryb embedded na
# dysku w .qdrant_lokalny/ (zero sieci, zero serwera). QDRANT_URL ma pierwszenstwo nad
# QDRANT_PATH - do uzycia z docker-compose.qdrant.yml (NIE testowany na tej maszynie, patrz
# komentarz w tym pliku).
# WYSZUKIWARKA=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_PATH=.qdrant_lokalny
# QDRANT_COLLECTION=owu-mienie-v1
# QDRANT_TRYB=hybryda
